from pathlib import Path
import os
import platform
import shutil

from SCons.Script import GetOption
"""
  The default cross-compilation toolchain can be specified in a 
  custom `config_defaults.mk` file and passed via the `CONFIG_DEFAULT_FILE` 
  environment variable.

export CONFIG_DEFAULT_FILE=linux_x86_cross_cp0_config_defaults.mk
scons -j8
"""


cross_package_enabled = False


def _sconstruct_path():
    """Return the directory containing this SConstruct, even with `scons -f`."""
    selected_files = GetOption("file")
    if selected_files:
        selected_file = Path(selected_files[0]).expanduser()
        if not selected_file.is_absolute():
            selected_file = Path.cwd() / selected_file
        return selected_file.resolve().parent
    return Path.cwd().resolve()


def _is_within(path, parent):
    try:
        path.relative_to(parent)
        return True
    except ValueError:
        return False


def _find_workspace_root(project_path):
    explicit_root = os.environ.get("CARDPUTERZERO_ROOT")
    if explicit_root:
        return Path(explicit_root).expanduser().resolve()

    for candidate in (project_path, *project_path.parents):
        if (
            (candidate / "SDK" / "tools" / "scons" / "project.py").is_file()
            and (candidate / "ext_components" / "cp0_lvgl" / "sdk_version.txt").is_file()
        ):
            return candidate

    raise RuntimeError(
        "Unable to locate the launcher workspace. Set CARDPUTERZERO_ROOT "
        "when the worker is outside the repository layout."
    )


def _resolve_config_file(project_path):
    selected_config = os.environ.get("CONFIG_DEFAULT_FILE")
    if os.environ.get("CardputerZero", "") == "y":
        selected_config = "linux_x86_cross_cp0_config_defaults.mk"
    elif selected_config is None and platform.machine() == "x86_64":
        selected_config = "linux_x86_sdl2_config_defaults.mk"
    elif selected_config is None:
        selected_config = "config_defaults.mk"

    config_path = Path(selected_config).expanduser()
    if not config_path.is_absolute():
        config_path = project_path / config_path
    config_path = config_path.resolve()
    if not config_path.is_file():
        raise FileNotFoundError(
            "CONFIG_DEFAULT_FILE does not exist: {}".format(config_path)
        )
    if not _is_within(config_path, project_path):
        raise RuntimeError(
            "CONFIG_DEFAULT_FILE must be inside the worker project: {}".format(
                config_path
            )
        )
    return config_path


project_path = _sconstruct_path()
workspace_root = _find_workspace_root(project_path)
sdk_path = Path(
    os.environ.get("CARDPUTERZERO_SDK_PATH", workspace_root / "SDK")
).expanduser().resolve()
ext_components_path = Path(
    os.environ.get(
        "CARDPUTERZERO_EXT_COMPONENTS_PATH", workspace_root / "ext_components"
    )
).expanduser().resolve()
version_file = ext_components_path / "cp0_lvgl" / "sdk_version.txt"

if not sdk_path.is_dir():
    raise FileNotFoundError("SDK path does not exist: {}".format(sdk_path))
if not version_file.is_file():
    raise FileNotFoundError("cp0_lvgl SDK version file does not exist: {}".format(version_file))

version = version_file.read_text(encoding="utf-8").strip()
static_lib_path = sdk_path / "github_source" / f"static_lib_{version}"

build_path = (project_path / "build").resolve()
dist_path = (project_path / "dist").resolve()
cache_path = (project_path / ".cache").resolve()
for output_name, output_path in (
    ("build", build_path),
    ("dist", dist_path),
    (".cache", cache_path),
):
    if not _is_within(output_path, project_path):
        raise RuntimeError(
            "{} output must remain inside the worker project: {}".format(
                output_name, output_path
            )
        )


def _validate_worker_links():
    """Reject copied workers whose resources resolve into another checkout."""
    for source_root in (project_path / "main", project_path / "APPLaunch"):
        if not source_root.exists() and not source_root.is_symlink():
            continue
        if source_root.is_symlink():
            resolved_root = source_root.resolve(strict=False)
            if not resolved_root.exists() or not _is_within(resolved_root, project_path):
                raise RuntimeError(
                    "Worker source/resource root is invalid: {} -> {}".format(
                        source_root, resolved_root
                    )
                )
        for candidate in source_root.rglob("*"):
            if not candidate.is_symlink():
                continue
            resolved_target = candidate.resolve(strict=False)
            if not _is_within(resolved_target, project_path):
                raise RuntimeError(
                    "Worker source/resource symlink escapes the worker directory: {} -> {}".format(
                        candidate, resolved_target
                    )
                )


_validate_worker_links()
cache_path.mkdir(parents=True, exist_ok=True)

config_path = _resolve_config_file(project_path)
cross_config_selected = "cross" in config_path.name
config_dir = build_path / "config"
generated_config_names = (
    "global_config.mk",
    "global_config.h",
    "lvgl_config.h",
    "config_tmp.mk",
)


def _remove_path(path):
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def _sync_selected_config():
    """Invalidate all config-dependent outputs when defaults change."""
    config_dir.mkdir(parents=True, exist_ok=True)
    selection_stamp = config_dir / "selected-defaults.txt"
    selection_identity = "{}\n{}".format(
        config_path,
        config_path.read_text(encoding="utf-8"),
    )
    if cross_config_selected:
        static_lib_version_file = static_lib_path / "version"
        static_lib_version = (
            static_lib_version_file.read_text(encoding="utf-8").strip()
            if static_lib_version_file.is_file()
            else "missing"
        )
        selection_identity += "\nstatic-lib={}\nstatic-lib-version={}\n".format(
            static_lib_path,
            static_lib_version,
        )
    previous_identity = (
        selection_stamp.read_text(encoding="utf-8")
        if selection_stamp.exists()
        else ""
    )
    if previous_identity == selection_identity:
        return

    for generated_name in generated_config_names:
        generated_path = config_dir / generated_name
        if generated_path.exists() or generated_path.is_symlink():
            generated_path.unlink()

    for output_path in (
        build_path,
        dist_path,
        project_path / "compile_commands.json",
        project_path / ".sconsign.dblite",
        project_path / ".config.old",
        project_path / ".config",
        project_path / ".config.mk",
    ):
        if output_path == build_path:
            for entry in output_path.iterdir():
                if entry.name != "config":
                    _remove_path(entry)
        elif output_path.exists() or output_path.is_symlink():
            _remove_path(output_path)

    selection_stamp.write_text(selection_identity, encoding="utf-8")


_sync_selected_config()

cross_package_enabled = cross_config_selected
config_tmp_path = config_dir / "config_tmp.mk"
if cross_package_enabled:
    sysroot_path_str = str(static_lib_path).replace('"', r'\"')
    config_tmp_content = 'CONFIG_TOOLCHAIN_SYSROOT="{}"\n'.format(sysroot_path_str)
    if (
        not config_tmp_path.exists()
        or config_tmp_path.read_text(encoding="utf-8") != config_tmp_content
    ):
        config_tmp_path.write_text(config_tmp_content, encoding="utf-8")
else:
    if config_tmp_path.exists() or config_tmp_path.is_symlink():
        config_tmp_path.unlink()

os.chdir(project_path)
os.environ.update(
    {
        "PROJECT_PATH": str(project_path),
        "PROJECT_NAME": "ui_test",
        "BUILD_PATH": str(build_path),
        "BUILD_CONFIG_PATH": str(config_dir),
        "CONFIG_DEFAULT_FILE": str(config_path),
        "GLOBAL_CONFIG_MK_FILE": str(config_dir / "global_config.mk"),
        "GLOBAL_CONFIG_H_FILE": str(config_dir / "global_config.h"),
        "KCONFIG_FILE": str(sdk_path / "Kconfig"),
        "SDK_PATH": str(sdk_path),
        "EXT_COMPONENTS_PATH": str(ext_components_path),
        "UI_TEST_WORKER_PATH": str(project_path),
        "UI_TEST_CACHE_PATH": str(cache_path),
    }
)

env = SConscript(
    str(sdk_path / "tools" / "scons" / "project.py"),
    variant_dir=str(project_path),
    duplicate=0,
)

# static_lib is only needed for cross-compilation, skip in SDL mode.
if cross_package_enabled:
    update = False
    if not static_lib_path.exists():
        update = True
    else:
        try:
            with open(str(static_lib_path / "version"), "r") as f:
                if version != f.read().strip():
                    update = True
        except Exception:
            update = True

    if update:
        with open(env["PROJECT_TOOL_S"]) as f:
            exec(f.read())
        try:
            import tarfile

            tarfile.TarFile.extraction_filter = staticmethod(
                tarfile.fully_trusted_filter
            )
        except AttributeError:
            pass
        down_url = (
            "https://github.com/CardputerZero/M5CardputerZero-UserDemo/"
            "releases/download/{}/sdk_bsp.tar.gz"
        ).format(version)
        check_wget_down(down_url, "static_lib_{}.tar.gz".format(version))
